{
  "name": "life-os",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A calm, scheduling-first task manager for an ADHD brain. The app proposes; you decide. Now full-stack with Google Calendar sync and push reminders.",
  "scripts": {
    "dev": "concurrently -k -n next,cron -c blue,magenta \"next dev\" \"tsx watch worker/scheduler.ts\"",
    "build": "next build",
    "start": "concurrently -k -n next,cron -c blue,magenta \"next start -H 127.0.0.1\" \"tsx worker/scheduler.ts\"",
    "start:web": "next start -H 127.0.0.1",
    "start:worker": "tsx worker/scheduler.ts",
    "worker": "tsx watch worker/scheduler.ts",
    "db:push": "drizzle-kit push",
    "migrate:multiuser": "tsx scripts/migrate-multiuser.mts",
    "clear-tasks": "tsx scripts/clear-tasks.mts",
    "seed-loose-ends": "tsx scripts/seed-loose-ends.mts",
    "seed-missed-dates": "tsx scripts/seed-missed-dates.mts",
    "seed-today": "tsx scripts/seed-today.mts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/brain.test.mts && tsx scripts/placement.test.mts && tsx scripts/deferral.test.mts && tsx scripts/breakdown.test.mts && tsx scripts/tags.test.mts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "googleapis": "^144.0.0",
    "jose": "^5.9.6",
    "motion": "^12.42.2",
    "next": "^15.1.4",
    "node-cron": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  }
}
