# ── Copy to .env and fill in. The worker and Next both read .env. ──

# Secret used to sign the per-user session cookie. Use a long random string.
COOKIE_SECRET=replace-with-a-long-random-string

# Where the SQLite file lives (relative to repo root).
DB_PATH=data/lifeos.db

# Public origin of the app. Used to build the post-OAuth redirect so it stays
# https behind a reverse proxy. Leave unset locally (falls back to the request
# origin); in production set it to your real URL.
# APP_ORIGIN=https://life-os.biratspkt.com

# ── Google OAuth (sign-in + Calendar; server stores the refresh token) ──
# REQUIRED for login: "Continue with Google" is the only way into the app, so
# the app is unusable until these are set.
# Create at https://console.cloud.google.com → enable "Google Calendar API",
# configure the OAuth consent screen (External, Testing, add yourself as a
# test user), then create an OAuth client of type "Web application" with the
# redirect URI below. In production this must be the https callback and must
# also be listed in the OAuth client's "Authorized redirect URIs" in Google
# Cloud Console, e.g. https://life-os.biratspkt.com/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ── Web push (VAPID). Generate once: npx web-push generate-vapid-keys ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Reminder scheduler ──
# How many minutes before a task starts to send the ping.
PING_LEAD_MINUTES=5
# Hour (0-23, local time) to send the morning summary.
MORNING_SUMMARY_HOUR=7

# ── Task breakdown (LLM) ──
# Gemini API key (free tier is fine): https://aistudio.google.com/apikey
# Optional — without it the breakdown sheet still works as a manual editor.
GEMINI_API_KEY=
# Override the model if the free-tier default is ever renamed.
# GEMINI_MODEL=gemini-2.5-flash
