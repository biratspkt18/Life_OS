# ── Copy to .env and fill in. The worker and Next both read .env. ──

# Single-user gate. The passcode you type on the login screen.
APP_PASSCODE=change-me
# Secret used to sign the session cookie. Use a long random string.
COOKIE_SECRET=replace-with-a-long-random-string

# Where the SQLite file lives (relative to repo root).
DB_PATH=data/daybook.db

# ── Google Calendar (in-browser OAuth, server stores the refresh token) ──
# Create at https://console.cloud.google.com → enable "Google Calendar API",
# configure the OAuth consent screen (External, Testing, add yourself as a
# test user), then create an OAuth client of type "Web application" with the
# redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ── Web push (VAPID). Generate once: npx web-push generate-vapid-keys ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Reminder scheduler ──
# How many minutes before a task starts to send the ping.
PING_LEAD_MINUTES=5
# Hour (0-23, local time) to send the morning summary.
MORNING_SUMMARY_HOUR=7
